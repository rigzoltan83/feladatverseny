APP_ENV=production

SECRET_KEY=CHANGE_ME

DB_HOST=127.0.0.1
# Set this to the actual PostgreSQL server port.
DB_PORT=5432
DB_NAME=feladatverseny
DB_USER=feladatverseny_user
DB_PASSWORD=CHANGE_ME

APP_TIMEZONE=Europe/Budapest
MEDIA_ROOT=/srv/feladatverseny/media

# Gunicorn listen address.
# Change the port if another application already uses it.
APP_BIND=127.0.0.1:8000

# Optional URL prefix when the application is published
# below a subpath, for example through Tailscale Serve.
# Leave empty for root deployment.
APPLICATION_PREFIX=
